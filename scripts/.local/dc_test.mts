const { NextRequest } = await import('next/server')
const H = await import('../../src/app/api/admin/history/route')
const D = await import('../../src/app/api/admin/daily-challenge/route')
const P = await import('../../src/app/api/admin/polls/route')
const h = await (await H.GET()).json()
console.log('history', h.finishes.length, h.titles.length, `${Math.round(JSON.stringify(h).length / 1024)} KB`)
const top = (rows: any[], key: (r: any) => string, n = 3) => { const m = new Map<string, number>(); for (const r of rows) m.set(key(r), (m.get(key(r)) ?? 0) + 1); return [...m].sort((a, b) => b[1] - a[1]).slice(0, n).map(([k, v]) => `${k} ${v}`).join('; ') }
const F = h.finishes as any[]
console.log('Most Region 7 champs (school):', top(F.filter(f => f.level === 'region' && f.region === 7), f => f.school))
console.log('Most Region 7 champs (wrestler):', top(F.filter(f => f.level === 'region' && f.region === 7), f => `${f.name} (${f.school})`))
console.log('Most 157 state champs (school):', top(F.filter(f => f.level === 'state' && f.weight === '157' && f.place === 1), f => f.school))
console.log('Most 157 state podiums (school):', top(F.filter(f => f.level === 'state' && f.weight === '157'), f => f.school))
console.log('Most state titles (wrestler):', top(F.filter(f => f.level === 'state' && f.place === 1), f => `${f.name} (${f.school})`, 5))
// questions: future add, past refused, delete
const tomorrow = new Date(Date.now() + 86400000 * 2).toLocaleDateString('en-CA', { timeZone: 'America/New_York' })
const put = (body: any) => D.PUT(new NextRequest('http://l/api', { method: 'PUT', body: JSON.stringify(body) }))
const r1 = await put({ gender: 'M', challenge_date: tomorrow, question: 'TEST Q', answer: 'TEST A' })
const r2 = await put({ gender: 'M', challenge_date: '2026-01-01', question: 'TEST', answer: 'TEST' })
const list = await (await D.GET(new NextRequest('http://l/api?gender=M'))).json()
const del = await D.DELETE(new NextRequest(`http://l/api?gender=M&date=${tomorrow}`, { method: 'DELETE' }))
console.log('question save', r1.status, '| past date refused', r2.status, (await r2.json()).error, '| listed', list.rows.length, '| removed', del.status)
const pc = await P.POST(new NextRequest('http://l/api', { method: 'POST', body: JSON.stringify({ gender: 'F', question: 'TEST poll', answer_1: 'a', answer_2: 'b', answer_3: 'c', answer_4: 'd' }) }))
const poll = (await pc.json()).row
const pa = await P.PATCH(new NextRequest('http://l/api', { method: 'PATCH', body: JSON.stringify({ gender: 'F', id: poll.id, archived: true }) }))
const bad = await P.POST(new NextRequest('http://l/api', { method: 'POST', body: JSON.stringify({ gender: 'F', question: 'x', answer_1: 'a' }) }))
console.log('poll create', pc.status, '| archive', pa.status, (await pa.json()).row.archived, '| missing answers refused', bad.status)
const { createClient } = await import('@supabase/supabase-js')
await createClient(process.env.NEXT_PUBLIC_SUPABASE_URL!, process.env.SUPABASE_SERVICE_ROLE_KEY!).from('girls_polls').delete().eq('id', poll.id)
console.log('test poll removed')
