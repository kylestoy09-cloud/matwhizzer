import { createClient } from '@supabase/supabase-js'
const db = createClient(process.env.NEXT_PUBLIC_SUPABASE_URL!, process.env.SUPABASE_SERVICE_ROLE_KEY!)
const T = ['dual_meet_matches','dual_meet_matches_girls','tournament_bouts','tournament_bouts_girls','tournament_entries','tournament_placements','tournament_bracket_slots','individual_rankings','individual_upsets','in_season_tournament_seeds','in_season_tournament_seeds_girls','pending_wrestler_transfers','wrestler_school_history','wrestler_hammer_scores','wrestler_match_score_log','lb_rs_wrestler','lb_ps_wrestler','snapshot_streak_state','snapshot_streak_state_boys','snapshot_streak_state_girls','snapshot_season_highs','snapshot_season_highs_boys','snapshot_season_highs_girls','wrestler_name_aliases','roster_grade_import','placements','matches','wrestler_ratings','ranking_snapshots','individual_ranking_snapshots','bracket_poll_picks','wrestler_follows']
for (const t of T) { const r = await db.from(t).select('*').limit(1); console.log(t, r.error ? 'MISSING ' + r.error.message.slice(0, 50) : Object.keys(r.data?.[0] ?? {}).filter(k => /wrestler|winner|loser|_id$/.test(k)).join(',')) }
