import { createClient } from '@supabase/supabase-js'
const db = createClient(process.env.NEXT_PUBLIC_SUPABASE_URL!, process.env.SUPABASE_SERVICE_ROLE_KEY!)
const ws = (await db.from('wrestlers').select('*').ilike('first_name', 'scratch%')).data!
console.log(JSON.stringify(ws.map((w: any) => ({ id: w.id, n: `${w.first_name}|${w.last_name}`, g: w.gender, stub: w.is_stub, created: w.created_at }))))
const REFS: [string, string][] = [['dual_meet_matches_girls', 'wrestler_a_id'], ['dual_meet_matches_girls', 'wrestler_b_id'], ['dual_meet_matches_girls', 'winner_id'], ['dual_meet_matches', 'wrestler_a_id'], ['dual_meet_matches', 'wrestler_b_id'], ['tournament_bouts_girls', 'wrestler1_id'], ['tournament_bouts_girls', 'wrestler2_id'], ['tournament_bouts', 'wrestler1_id'], ['tournament_bouts', 'wrestler2_id'], ['tournament_entries', 'wrestler_id'], ['tournament_placements', 'wrestler_id'], ['roster_grade_import', 'wrestler_id'], ['wrestler_name_aliases', 'wrestler_id'], ['wrestler_hammer_scores', 'wrestler_id'], ['wrestler_match_score_log', 'wrestler_id'], ['wrestler_match_score_log', 'opponent_wrestler_id'], ['lb_rs_wrestler', 'wrestler_id'], ['lb_ps_wrestler', 'wrestler_id'], ['snapshot_streak_state_girls', 'wrestler_id'], ['individual_rankings', 'wrestler_id'], ['in_season_tournament_seeds_girls', 'wrestler_id'], ['tournament_bracket_slots', 'top_wrestler_id'], ['tournament_bracket_slots', 'bottom_wrestler_id']]
for (const w of ws) for (const [t, c] of REFS) { const r = await db.from(t).select('*', { count: 'exact', head: true }).eq(c, w.id); if (r.count) console.log(' ', w.first_name, t, c, r.count) }
