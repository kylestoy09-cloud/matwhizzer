// Full sandbox week: questions Mon–Wed of 2026-11-02, players A/B/C, winners on the next Monday, prize form, poll.
const { NextRequest } = await import('next/server')
const C = await import('../../src/app/api/challenge/route')
const L = await import('../../src/app/api/challenge/leaderboard/route')
const K = await import('../../src/app/api/challenge/claim/route')
const P = await import('../../src/app/api/poll/route')
const AQ = await import('../../src/app/api/admin/daily-challenge/route')
const AP = await import('../../src/app/api/admin/polls/route')
const W = await import('../../src/app/api/admin/challenge-winners/route')
const j = (r: Response) => r.json()
const req = (url: string, body?: unknown, method = body ? 'POST' : 'GET') => new NextRequest(`http://l${url}`, body ? { method, body: JSON.stringify(body) } : undefined)
const sb = (asOf: string, player: string) => ({ sandbox: true, asOf, player })
const q = (asOf: string, player: string) => `?sandbox=1&asOf=${asOf}&player=${encodeURIComponent(player)}`
const ok = (label: string, cond: boolean, extra = '') => console.log(`${cond ? 'PASS' : 'FAIL'}  ${label}${extra ? ' — ' + extra : ''}`)

await AQ.DELETE(req('/api?sandbox=1&reset=1', undefined, 'DELETE'))
const days = { mon: '2026-11-02', tue: '2026-11-03', wed: '2026-11-04', sun: '2026-11-08', nextMon: '2026-11-09' }
const put = (b: any) => AQ.PUT(req('/api', { sandbox: true, ...b }, 'PUT'))
ok('choice question saved', (await put({ challenge_date: days.mon, topic: 'boys', kind: 'choice', question: 'Most Region 7 titles?', options: ['Eastern', 'Camden Catholic', 'Lenape', 'Seneca'], correct: [1] })).status === 200)
ok('ranking question saved', (await put({ challenge_date: days.tue, topic: 'girls', kind: 'rank', question: 'Order by titles', options: ['A', 'B', 'C', 'D'], correct: [2, 0, 3, 1] })).status === 200)
ok('5-second question saved', (await put({ challenge_date: days.wed, topic: 'general', kind: 'choice', question: 'Quick one', options: ['w', 'x', 'y', 'z'], correct: [3], time_limit_sec: 5 })).status === 200)
ok('bad ranking refused', (await put({ challenge_date: days.sun, kind: 'rank', question: 'x', options: ['a', 'b', 'c', 'd'], correct: [0, 0, 1, 2] })).status === 400)

const play = async (day: string, who: string, answer: number[] | null, waitMs = 0) => {
  const s = await j(await C.POST(req('/api', { ...sb(day, who), action: 'start' })))
  if (waitMs) await new Promise(r => setTimeout(r, waitMs))
  return answer ? j(await C.POST(req('/api', { ...sb(day, who), action: 'answer', answer }))) : s
}
const before = await j(await C.GET(req(`/api${q(days.mon, 'A')}`)))
ok('before starting: button only, question hidden', before.status === 'ready' && !before.question, `limit ${before.time_limit_sec}s`)
const s1 = await j(await C.POST(req('/api', { ...sb(days.mon, 'A'), action: 'start' })))
ok('start shows the question with the clock', s1.status === 'playing' && !!s1.question && s1.ms_left > 25000, `${Math.round(s1.ms_left / 1000)}s left`)
await new Promise(r => setTimeout(r, 1200))
const s2 = await j(await C.POST(req('/api', { ...sb(days.mon, 'A'), action: 'start' })))
ok('starting again keeps the first clock', s2.ms_left < s1.ms_left - 1000)
const a1 = await j(await C.POST(req('/api', { ...sb(days.mon, 'A'), action: 'answer', answer: [1] })))
ok('right answer, time recorded, answer shown', a1.is_correct === true && a1.elapsed_ms > 1000 && a1.correct?.[0] === 1, `${a1.elapsed_ms} ms`)
const a1b = await j(await C.POST(req('/api', { ...sb(days.mon, 'A'), action: 'answer', answer: [0] })))
ok('second attempt ignored', a1b.is_correct === true)
ok('B right on Monday', (await play(days.mon, 'B', [1])).is_correct === true)
ok('C wrong on Monday', (await play(days.mon, 'C', [2])).is_correct === false)
ok('A ranking right', (await play(days.tue, 'A', [2, 0, 3, 1])).is_correct === true)
ok('B ranking wrong order', (await play(days.tue, 'B', [0, 2, 3, 1])).is_correct === false)
const late = await play(days.wed, 'C', [3], 7000)
ok('C right answer but late (5s + grace) = out of time', late.is_correct === false && late.timed_out === true)
await play(days.wed, 'B', null)            // opened, never answered
await new Promise(r => setTimeout(r, 7000))
const gone = await j(await C.GET(req(`/api${q(days.wed, 'B')}`)))
ok('opened and walked away = out of time', gone.status === 'done' && gone.timed_out === true)
ok('A right on Wednesday', (await play(days.wed, 'A', [3])).is_correct === true)
const thu = await j(await C.GET(req(`/api${q('2026-11-05', 'A')}`)))
ok('a day with no question says so', thu.available === false)

const board = await j(await L.GET(req(`/api/leaderboard${q(days.sun, 'B')}`)))
ok('Sunday standings: A (3), B (1), C (0)', board.rows.map((r: any) => `${r.name}:${r.correct}`).join(' ') === 'A:3 B:1 C:0', board.rows.map((r: any) => `${r.name} ${r.correct}/${r.answered} ${r.ms}ms`).join(' | '))
ok('my row is marked', board.rows.find((r: any) => r.me)?.name === 'B')
ok('no winners before the week ends', board.winners.length === 0)

const monday = await j(await L.GET(req(`/api/leaderboard${q(days.nextMon, 'A')}`)))
const w = monday.winners[0]
ok('next Monday: week decided, A is the top winner', w?.top === 'A' && w.top_correct === 3, JSON.stringify(w))
ok('random winner is B or C (not A)', ['B', 'C'].includes(w?.random))
const again = await j(await L.GET(req(`/api/leaderboard${q(days.nextMon, 'C')}`)))
ok('decided once (visiting again changes nothing)', again.winners.length === 1 && again.winners[0].random === w.random)

const claims = await j(await K.GET(req(`/api/claim${q(days.nextMon, 'A')}`)))
ok('A has a prize to claim', claims.claims.length === 1 && claims.claims[0].kind === 'top')
ok('form refused without an address', (await K.POST(req('/api', { ...sb(days.nextMon, 'A'), id: claims.claims[0].id, shirt_size: 'L' }))).status === 400)
ok('form sent', (await K.POST(req('/api', { ...sb(days.nextMon, 'A'), id: claims.claims[0].id, full_name: 'Test Winner', shirt_size: 'L', address1: '1 Main St', city: 'Newark', state: 'nj', zip: '07102' }))).status === 200)
ok("C can't send A's form", (await K.POST(req('/api', { ...sb(days.nextMon, 'C'), id: claims.claims[0].id, full_name: 'X', shirt_size: 'L', address1: 'x', city: 'x', state: 'NJ', zip: '07102' }))).status === 404)
const admin = await j(await W.GET(req('/api?sandbox=1')))
const top = admin.claims.find((c: any) => c.kind === 'top')
ok('admin Winners shows the size and address', top?.submitted_at && top.state === 'NJ' && top.shirt_size === 'L', `${admin.claims.length} claims, ${admin.weeks.length} week`)

const poll = await j(await AP.POST(req('/api', { sandbox: true, topic: 'general', question: 'Best weight?', answers: ['106', '157', '215', 'Hwt'], poll_date: days.mon })))
const p0 = await j(await P.GET(req(`/api/poll${q(days.mon, 'A')}`)))
ok('poll shows answers before voting, no percentages', p0.available && p0.voted === null && !p0.pct)
await P.POST(req('/api', { ...sb(days.mon, 'A'), choice: 1 }))
await P.POST(req('/api', { ...sb(days.mon, 'B'), choice: 1 }))
const p2 = await j(await P.POST(req('/api', { ...sb(days.mon, 'C'), choice: 3 })))
ok('percentages after voting', p2.voted === 3 && p2.total === 3 && p2.pct[1] === 66.7 && p2.pct[3] === 33.3, JSON.stringify(p2.pct))
const p3 = await j(await P.POST(req('/api', { ...sb(days.mon, 'C'), choice: 0 })))
ok('one vote each', p3.voted === 3 && p3.total === 3)

// clean up the test
await AQ.DELETE(req('/api?sandbox=1&reset=1', undefined, 'DELETE'))
const { createClient } = await import('@supabase/supabase-js')
const db = createClient(process.env.NEXT_PUBLIC_SUPABASE_URL!, process.env.SUPABASE_SERVICE_ROLE_KEY!)
await db.from('daily_challenges').delete().eq('sandbox', true)
await db.from('polls').delete().eq('id', poll.row.id)
console.log('test data removed')
