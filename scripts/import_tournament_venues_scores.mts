// ── Helpers ──────────────────────────────────────────────────────────────────

function normalize(s: string): string {
  return s.toLowerCase().replace(/[^a-z0-9]/g, ' ').replace(/\s+/g, ' ').trim()
}

function schoolNameMatch(query: string, candidates: { id: number; display_name: string; short_name: string | null }[]): number | null {
  const q = normalize(query)
  // Exact match
  for (const c of candidates) {
    if (normalize(c.display_name) === q) return c.id
    if (c.short_name && normalize(c.short_name) === q) return c.id
  }
  // Starts-with match (query starts with candidate name or vice versa)
  for (const c of candidates) {
    const cn = normalize(c.display_name)
    if (cn.startsWith(q) || q.startsWith(cn)) return c.id
    if (c.short_name) {
      const sn = normalize(c.short_name)
      if (sn.startsWith(q) || q.startsWith(sn)) return c.id
    }
  }
  // Contains match
  for (const c of candidates) {
    const cn = normalize(c.display_name)
    if (cn.includes(q) || q.includes(cn)) return c.id
  }
  return null
}

// ── Main ─────────────────────────────────────────────────────────────────────

console.log('Loading tournaments from DB...')
const { data: dbTournaments, error: te } = await supabase
  .from('in_season_tournaments')
  .select('id, name')
  .order('name')
if (te) throw new Error(`Tournaments query failed: ${te.message}`)

console.log(`Found ${dbTournaments!.length} tournaments`)

// Build tournament name → id map
function findTournament(patterns: string[]): { id: string; name: string } | null {
  for (const t of dbTournaments!) {
    for (const p of patterns) {
      if (t.name.toLowerCase().includes(p.toLowerCase())) return t
    }
  }
  return null
}

console.log('\nLoading NJ schools from DB...')
const { data: allSchools, error: se } = await supabase
  .from('schools')
  .select('id, display_name, short_name, is_nj')
  .order('display_name')
if (se) throw new Error(`Schools query failed: ${se.message}`)

const njSchools = allSchools!.filter(s => s.is_nj)
console.log(`Found ${njSchools.length} NJ schools`)

// Process each tournament
let venuesUpdated = 0
let scoresInserted = 0
let notFound = 0

for (const td of TOURNAMENTS) {
  const match = findTournament(td.namePatterns)
  if (!match) {
    console.warn(`  NOT FOUND: ${td.namePatterns[0]}`)
    notFound++
    continue
  }

  // Find venue school_id (for NJ school banner)
  let venueSchoolId: number | null = null
  if (td.venueSchoolPattern) {
    venueSchoolId = schoolNameMatch(td.venueSchoolPattern, njSchools)
    if (!venueSchoolId) {
      console.warn(`  Could not match venue school: "${td.venueSchoolPattern}" for ${match.name}`)
    }
  }

  // Update tournament venue info
  const updatePayload: Record<string, unknown> = {
    venue_name: td.venue,
    venue_address: td.address,
    is_oos: td.isOos,
    location_school_id: venueSchoolId,
  }
  if (td.bannerBg) updatePayload.banner_bg = td.bannerBg
  if (td.bannerFg) updatePayload.banner_fg = td.bannerFg

  const { error: ue } = await supabase
    .from('in_season_tournaments')
    .update(updatePayload)
    .eq('id', match.id)
  if (ue) {
    console.error(`  ERROR updating ${match.name}: ${ue.message}`)
    continue
  }
  venuesUpdated++

  // Insert scores
  if (!td.scores?.length) {
    console.log(`  ✓ ${match.name} — venue updated (no scores)`)
    continue
  }

  // Delete existing scores for this tournament
  const { error: de } = await supabase
    .from('in_season_tournament_team_scores')
    .delete()
    .eq('tournament_id', match.id)
  if (de) console.warn(`  Warning deleting old scores for ${match.name}: ${de.message}`)

  // Match school names to IDs
  const rows = td.scores.map(s => {
    const schoolId = schoolNameMatch(s.school, allSchools!)
    return {
      tournament_id: match.id,
      place: s.place,
      school_name: s.school,
      school_id: schoolId,
      score: s.score,
    }
  })

  // Insert in batches of 100
  for (let i = 0; i < rows.length; i += 100) {
    const batch = rows.slice(i, i + 100)
    const { error: ie } = await supabase
      .from('in_season_tournament_team_scores')
      .insert(batch)
    if (ie) {
      console.error(`  ERROR inserting scores for ${match.name}: ${ie.message}`)
      break
    }
    scoresInserted += batch.length
  }

  const njMatched = rows.filter(r => r.school_id !== null).length
  console.log(`  ✓ ${match.name} — ${rows.length} teams, ${njMatched} matched to NJ schools`)
}

console.log(`\n=== Import Complete ===`)
console.log(`Venues updated: ${venuesUpdated}`)
console.log(`Team scores inserted: ${scoresInserted}`)
if (notFound > 0) console.log(`Tournaments not found in DB: ${notFound}`)
