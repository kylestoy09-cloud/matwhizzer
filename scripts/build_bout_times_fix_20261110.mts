// Bout times that can't be real → 6:00 (Kyle 2026-11-10). Writes docs/migrations/20261110_bout_times_to_6_00.sql and
// a backup of every row it changes. Read-only on the DB.
//   falls at 0:00-0:02; tech falls under 0:13 (the minimum) or with no time; injury defaults at 0:00-0:02 or with no time
//   npx tsx --tsconfig tsconfig.json scripts/build_bout_times_fix_20261110.mts
import { createClient } from '@supabase/supabase-js'
import fs from 'fs'
const db = createClient(process.env.NEXT_PUBLIC_SUPABASE_URL!, process.env.SUPABASE_SERVICE_ROLE_KEY!)
const T: [string, string, Record<string, string[]>][] = [
  ['dual_meet_matches', 'result_type', { fall: ['Fall'], tf: ['TF'], inj: ['Inj.'] }],
  ['dual_meet_matches_girls', 'result_type', { fall: ['Fall'], tf: ['TF'], inj: ['Inj.'] }],
  ['tournament_bouts', 'result_type', { fall: ['Fall'], tf: ['TF'], inj: ['Inj.'] }],
  ['tournament_bouts_girls', 'result_type', { fall: ['Fall'], tf: ['TF'], inj: ['Inj.'] }],
  ['matches', 'win_type', { fall: ['FALL'], tf: ['TF-1.5', 'TF-1'], inj: ['INJ'] }],
]
const LIMIT = { fall: 3, tf: 13, inj: 3 } as const
const backup: Record<string, any[]> = {}, sql: string[] = [], verify: string[] = [], summary: string[] = []
for (const [tb, col, kinds] of T) {
  const rows: any[] = []
  for (const [k, vals] of Object.entries(kinds)) {
    const lim = LIMIT[k as keyof typeof LIMIT]
    for (let i = 0; ; i += 1000) {
      const { data, error } = await db.from(tb).select('*').in(col, vals).or(`fall_time_seconds.lt.${lim},fall_time_seconds.is.null`).order('id').range(i, i + 999)
      if (error) throw new Error(`${tb}: ${error.message}`)
      // falls with no time are not part of this change (only a wrong time is)
      rows.push(...(data ?? []).filter((r: any) => !(k === 'fall' && r.fall_time_seconds == null)).map((r: any) => ({ ...r, _kind: k })))
      if ((data?.length ?? 0) < 1000) break
    }
    const cond = `${col}::text IN (${vals.map(v => `'${v}'`).join(', ')}) AND ${k === 'fall' ? `fall_time_seconds < ${lim}` : `(fall_time_seconds < ${lim} OR fall_time_seconds IS NULL)`}`
    verify.push(`SELECT '${tb} ${k}' AS what, count(*) FROM ${tb} WHERE ${cond}`)
  }
  backup[tb] = rows
  if (!rows.length) continue
  const by = (k: string) => rows.filter(r => r._kind === k).length
  summary.push(`${tb}: ${rows.length} (falls ${by('fall')}, tech falls ${by('tf')}, injury defaults ${by('inj')})`)
  sql.push(`  -- ${summary[summary.length - 1]}`)
  sql.push(`  UPDATE ${tb} SET fall_time_seconds = 360 WHERE id IN (\n${rows.map(r => `    '${r.id}'`).join(',\n')}\n  ) AND (fall_time_seconds IS NULL OR fall_time_seconds < 13);`)
  sql.push(`  GET DIAGNOSTICS n = ROW_COUNT; IF n <> ${rows.length} THEN RAISE EXCEPTION '${tb}: % of ${rows.length}', n; END IF;`)
}
fs.writeFileSync('docs/migrations/backups/20261110_bout_times_before.json', JSON.stringify(backup))
const total = Object.values(backup).reduce((s, r) => s + r.length, 0)
fs.writeFileSync('docs/migrations/20261110_bout_times_to_6_00.sql', `-- docs/migrations/20261110_bout_times_to_6_00.sql  (generated by scripts/build_bout_times_fix_20261110.mts)
--
-- Bout times that can't be real, set to 6:00 (Kyle 2026-11-10), all seasons, ${total} bouts:
--   falls at 0:00-0:02 (0:00 = time never entered; 0:03 and up can happen and stay);
--   tech falls under 0:13 (the minimum) or with no time; injury defaults at 0:00-0:02 or with no time.
-- Only fall_time_seconds changes; no score text. Replaces 20261110_falls_under_3s_to_6_00.sql (never applied:
-- its check query failed on the enum win_type and the run rolled back).
${summary.map(s => '--   ' + s).join('\n')}
-- Backup: docs/migrations/backups/20261110_bout_times_before.json
-- Run in the Supabase SQL editor.

DO $$
DECLARE n int;
BEGIN
${sql.join('\n')}
END $$;

-- Verify: every count 0
${verify.join('\nUNION ALL ')};
`)
console.log(summary.join('\n')); console.log('total', total)
